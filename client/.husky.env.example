# ==============================================================================
# 훅 클라이언트 설정 (client/.husky.env)
# ==============================================================================
# Claude Code 훅은 settings.json에서 환경 변수를 직접 지정할 수 없습니다.
# (공식 스펙상 command 훅에 env 필드가 없고, 부모 환경을 상속할 뿐입니다)
#
# 따라서 서버 주소나 토큰은 이 파일에 적습니다.
# 이 파일을 .husky.env로 복사한 뒤 값을 채우세요.
#
#   cp client/.husky.env.example client/.husky.env
#
# 설정 탐색 순서 (먼저 찾은 값이 이깁니다):
#   1) 프로세스 환경 변수
#   2) client/.husky.env       ← 이 파일
#   3) 프로젝트 루트 .env      ← 서버와 같은 PC라면 여기만 채워도 됩니다
#
# 📌 서버를 다른 기기(예: Mac mini)에서 돌린다면, Claude Code가 실행되는 PC마다
#    이 파일에 서버 주소를 적어야 합니다.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1차 경로: Husky 중앙 서버
# ------------------------------------------------------------------------------
# 서버 기본 URL. ngrok 등 터널을 쓰면 여기에 https://… 를 적습니다.
# 스킴(http/https)으로 훅이 평문/TLS를 고릅니다. 경로 접두사도 허용합니다.
#   예) https://xxxx.ngrok-free.app
#       https://example.com/husky
#       http://127.0.0.1:3001
# ⚠️ 이 값이 있으면 아래 HUSKY_HOST / HUSKY_PORT 는 무시됩니다.
HUSKY_URL=

# HUSKY_URL 없이 같은 PC·같은 LAN에서 쓸 때만 사용합니다 (항상 평문 http).
#   같은 PC          → 127.0.0.1
#   Mac mini (LAN)   → 192.168.0.10   ← 공유기 DHCP 예약으로 고정한 IPv4를 적으세요
HUSKY_HOST=127.0.0.1
HUSKY_PORT=3001

# 서버에서 API_SECRET_KEY를 설정했다면 같은 값을 넣으세요.
# 서버를 루프백 밖으로 열었다면 서버 쪽에서 이 값이 필수입니다.
# ⚠️ **이 파일에 반드시 명시하세요.** 훅은 HUSKY_TOKEN만 보며,
#    루트 .env의 API_SECRET_KEY를 인정하지 않습니다 (에이전트는 인정합니다).
HUSKY_TOKEN=

# 서버 응답 대기 시간 (ms). 서버의 HOOK_TIMEOUT_MS(기본 1740000)보다 커야 합니다.
# 여유 10초는 왕복 지연(RTT)을 흡수하기 위한 값입니다.
HUSKY_HOOK_TIMEOUT_MS=1750000

# ------------------------------------------------------------------------------
# 2차 경로: 디스코드 직접 승인 (서버에 닿지 못할 때만 동작)
# ------------------------------------------------------------------------------
# 서버가 꺼져 있거나 네트워크가 끊겼을 때, 훅이 디스코드 REST API로 직접
# 승인 메시지를 올리고 ✅/❌ 리액션을 폴링합니다. 버튼 대신 리액션을 쓰기 때문에
# 봇 프로세스가 떠 있지 않아도 동작합니다.
#
# 끄려면 0으로 설정하세요. 끄면 서버 미연결 시 항상 로컬 권한 프롬프트로 넘어갑니다.
HUSKY_DIRECT_FALLBACK=1

# 서버와 같은 봇/채널을 그대로 쓰면 됩니다.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ⚠️ 리액션을 눌러도 이 목록에 없는 사용자면 무시됩니다.
#    비워두면 아무도 승인할 수 없어 폴백이 동작하지 않습니다 (fail-closed).
DISCORD_ALLOWED_USER_IDS=

# 리액션 대기 시간 (ms). 기본 8분.
# 훅 timeout(초)보다 작아야 하며, 1차 경로와 합쳐 초과하지 않도록 주의하세요.
HUSKY_DIRECT_TIMEOUT_MS=480000

# 훅 전체 예산 (ms). settings.json 의 timeout(초) × 1000 − 40000 으로 맞춥니다.
# 1차(서버 대기)가 오래 끌었으면 2차(리액션) 대기를 자동으로 줄여 합계가 이 값을
# 넘지 않게 합니다. 남은 시간이 30초 미만이면 2차를 아예 생략합니다
# (Claude Code가 훅을 죽인 뒤 디스코드에 고아 승인 메시지가 남는 것을 막습니다).
# 40초는 대기가 끝난 뒤의 마무리 몫입니다 — 폴링 주기 3초 + 리액션 조회 15초 +
# 마감 메시지 수정 15초 + 출력 플러시 2초.
HUSKY_TOTAL_BUDGET_MS=1820000

# ------------------------------------------------------------------------------
# 공통
# ------------------------------------------------------------------------------
# 승인 메시지에 표시할 PC 이름. 비우면 hostname을 자동 사용합니다.
# 여러 PC에서 Claude Code를 돌린다면 구분용으로 지정해두면 편합니다.
HUSKY_HOST_LABEL=

# ------------------------------------------------------------------------------
# Windows 에이전트 (agent/) — 훅과 같은 설정 파일을 공유합니다
# ------------------------------------------------------------------------------
# 토스트 알림 사용 여부
HUSKY_AGENT_NOTIFICATIONS=1

# 세션 하트비트 주기 (ms)
HUSKY_AGENT_HEARTBEAT_MS=30000

# 토스트 알림 본문 클릭·트레이 메뉴 '대시보드 열기'가 열 주소.
# 비우면 서버 origin의 /proxyDashboard/ 를 엽니다 (서버가 이 경로로 서빙).
# HUSKY_URL에 /claudeProxy 같은 서브패스가 있어도 대시보드는 origin 루트 기준입니다.
# 예: https://<ngrok 도메인>/proxyDashboard/
HUSKY_DASHBOARD_URL=
